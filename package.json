{
  "name": "workspace",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./app\" --filter \"./scripts\" --if-present run typecheck",
    "check:generated": "node scripts/extract-pns-transitions.mjs --check && node scripts/extract-skill-deps.mjs --check",
    "regen:generated": "node scripts/extract-pns-transitions.mjs && node scripts/extract-skill-deps.mjs",
    "skill:validate": "node scripts/validate-skills.mjs",
    "skill:validate:agents": "node scripts/validate-agent-skills.mjs",
    "skill:test": "node --test skills/okhp3-process-intake-and-scope/tests/*.test.mjs skills/okhp3-stakeholder-and-role-mapping/tests/*.test.mjs skills/okhp3-elicitation-interviews/tests/*.test.mjs skills/okhp3-as-is-process-capture/tests/*.test.mjs skills/okhp3-process-narrative-authoring/tests/*.test.mjs skills/okhp3-visual-process-modeling/tests/*.test.mjs skills/okhp3-process-gap-exception-analysis/tests/*.test.mjs skills/okhp3-future-state-change-strategy/tests/*.test.mjs skills/okhp3-decision-model-authoring/tests/*.test.mjs skills/okhp3-process-validation-scoring/tests/*.test.mjs skills/okhp3-process-measures-controls/tests/*.test.mjs skills/okhp3-sop-work-instructions/tests/*.test.mjs skills/okhp3-raci-governance-matrix/tests/*.test.mjs skills/okhp3-sipoc-generation/tests/*.test.mjs skills/okhp3-publication-handoff-packaging/tests/*.test.mjs skills/__tests__/pipeline.integration.test.mjs",
    "skill:package": "node scripts/package-skills.mjs",
    "eval:run": "node scripts/run-eval-suite.mjs",
    "technology:check": "node scripts/check-technology-versions.mjs",
    "brand:check": "node scripts/check-forge-profile.mjs",
    "brand:check:test": "node --test scripts/check-forge-profile.test.mjs",
    "check:generated:test": "node --test scripts/check-generated.test.mjs",
    "skill:validate:test": "node --test scripts/validate-skills.test.mjs",
    "deploy:playground": "pnpm --filter @workspace/mermaid-diagram-bpmn run build",
    "plugin:build": "pnpm --filter @okhp3/mermaid-diagram-bpmn run build",
    "plugin:pack": "pnpm --filter @okhp3/mermaid-diagram-bpmn run pack:dry-run",
    "plugin:smoke": "node scripts/run-plugin-smoke.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "check:content:test": "node --test scripts/validate-content.test.mjs",
    "check:test-count": "node scripts/check-test-count.mjs",
    "check:test-count:test": "node --test scripts/check-test-count.test.mjs",
    "check:dfki-7699": "node scripts/check-dfki-7699.mjs",
    "check:dfki-7699:test": "node --test scripts/check-dfki-7699.test.mjs",
    "check:version-status": "node scripts/check-version-status.mjs",
    "check:browser-cdn": "node scripts/check-browser-cdn.mjs",
    "check:release-gates": "node scripts/check-release-gates.mjs",
    "check:version-status:test": "node --test scripts/check-version-status.test.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:bundle-size:test": "node --test scripts/check-bundle-size.test.mjs",
    "manifest:generate": "node scripts/generate-manifest.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check"
  },
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "devDependencies": {
    "typescript": "~7.0.2",
    "prettier": "^3.9.5"
  }
}
