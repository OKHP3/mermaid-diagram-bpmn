{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "skill:validate": "node scripts/validate-skills.mjs",
    "skill:test": "node --test skills/okhp3-process-discovery/tests/*.test.mjs skills/okhp3-process-narrative/tests/*.test.mjs skills/okhp3-bpmn-for-mermaid/tests/*.test.mjs skills/okhp3-mermaid-theme-builder/tests/*.test.mjs skills/process-intake-and-scope/tests/*.test.mjs skills/stakeholder-and-role-mapping/tests/*.test.mjs skills/elicitation-and-interview-facilitation/tests/*.test.mjs skills/as-is-process-capture/tests/*.test.mjs skills/process-narrative-authoring/tests/*.test.mjs skills/visual-process-modeling/tests/*.test.mjs skills/process-gap-and-exception-analysis/tests/*.test.mjs skills/future-state-and-change-strategy/tests/*.test.mjs skills/decision-model-authoring/tests/*.test.mjs skills/process-validation-and-quality-scoring/tests/*.test.mjs skills/process-measures-and-controls-definition/tests/*.test.mjs skills/sop-and-work-instruction-generation/tests/*.test.mjs skills/raci-and-governance-matrix-generation/tests/*.test.mjs skills/sipoc-generation/tests/*.test.mjs skills/publication-and-handoff-packaging/tests/*.test.mjs",
    "skill:package": "node scripts/package-skills.mjs"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
