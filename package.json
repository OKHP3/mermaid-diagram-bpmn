{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./app\" --filter \"./scripts\" --if-present run typecheck",
    "check:generated": "node scripts/extract-pns-transitions.mjs --check",
    "skill:validate": "node scripts/validate-skills.mjs",
    "skill:test": "node --test skills/process-intake-and-scope/tests/*.test.mjs skills/stakeholder-and-role-mapping/tests/*.test.mjs skills/elicitation-and-interview-facilitation/tests/*.test.mjs skills/as-is-process-capture/tests/*.test.mjs skills/process-narrative-authoring/tests/*.test.mjs skills/visual-process-modeling/tests/*.test.mjs skills/process-gap-and-exception-analysis/tests/*.test.mjs skills/future-state-and-change-strategy/tests/*.test.mjs skills/decision-model-authoring/tests/*.test.mjs skills/process-validation-and-quality-scoring/tests/*.test.mjs skills/process-measures-and-controls-definition/tests/*.test.mjs skills/sop-and-work-instruction-generation/tests/*.test.mjs skills/raci-and-governance-matrix-generation/tests/*.test.mjs skills/sipoc-generation/tests/*.test.mjs skills/publication-and-handoff-packaging/tests/*.test.mjs skills/__tests__/pipeline.integration.test.mjs",
    "skill:package": "node scripts/package-skills.mjs",
    "eval:run": "node scripts/run-eval-suite.mjs",
    "deploy:playground": "pnpm --filter @workspace/mermaid-diagram-bpmn run build"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
