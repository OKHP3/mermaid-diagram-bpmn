{
  "name": "@okhp3/mermaid-diagram-bpmn",
  "version": "0.1.0",
  "description": "bpmn-beta diagram type plugin for Mermaid — readable, text-first BPMN process notation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "mermaid": ">=10.0.0"
  },
  "keywords": [
    "mermaid",
    "bpmn",
    "diagram",
    "plugin",
    "bpmn-beta",
    "process-modeling"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/okhp3/mermaid-diagram-bpmn.git"
  },
  "homepage": "https://okhp3.github.io/mermaid-diagram-bpmn/",
  "scripts": {
    "build": "vite build --config vite.config.ts && cp index.d.ts dist/index.d.ts && cp index.d.ts dist/index.d.cts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:"
  }
}
