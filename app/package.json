{
  "name": "@workspace/mermaid-diagram-bpmn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-skill-files.mjs && vite --config vite.config.ts --host 0.0.0.0",
    "skill:generate": "node scripts/generate-skill-files.mjs",
    "build": "node scripts/generate-skill-files.mjs && vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test e2e/host-demo.spec.ts e2e/playground-error-highlight.spec.ts e2e/url-sharing.spec.ts e2e/lint-warnings.spec.ts",
    "test:e2e:sharing": "playwright test e2e/url-sharing.spec.ts --project=chromium",
    "test:e2e:visual": "playwright test e2e/visual-regression.spec.ts --project=chromium",
    "test:e2e:update-snapshots": "playwright test e2e/visual-regression.spec.ts --project=chromium --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "^4.13.0",
    "clsx": "catalog:",
    "fflate": "catalog:",
    "happy-dom": "^20.10.6",
    "lucide-react": "catalog:",
    "mermaid": "11.16.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vitest": "^4.1.10",
    "wouter": "^3.10.0"
  }
}
