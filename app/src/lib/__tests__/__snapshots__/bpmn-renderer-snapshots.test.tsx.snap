    .bpmn-flow--association { stroke: hsl(var(--border)); opacity: 0.7; stroke-dasharray: 2 3; }
    .bpmn-arrow { fill: hsl(var(--foreground)); }
    .bpmn-arrow-open { fill: none; stroke: hsl(var(--foreground)); stroke-width: 1; }
    .bpmn-slash { stroke: hsl(var(--foreground)); stroke-width: 1.5; }
    .bpmn-text { fill: hsl(var(--foreground)); font-family: var(--app-font-sans, 'DM Sans', system-ui, sans-serif); }
    .bpmn-text-muted { fill: hsl(var(--foreground)); opacity: 0.7; font-family: var(--app-font-mono, 'JetBrains Mono', monospace); }
    .bpmn-text-label { fill: hsl(var(--foreground)); font-family: var(--app-font-sans, 'DM Sans', system-ui, sans-serif); font-weight: 600; }
  </style><marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" class="bpmn-arrow"></polygon></marker><marker id="arrowhead-msg" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" class="bpmn-arrow-open" stroke-width="1"></polygon></marker><marker id="slash-marker" markerWidth="8" markerHeight="10" refX="4" refY="5" orient="auto"><line x1="6" y1="1" x2="2" y2="9" class="bpmn-slash"></line></marker></defs><g><line x1="130" y1="0" x2="285" y2="0" class="bpmn-flow-sequence" stroke-width="1.8" marker-end="url(#arrowhead)"></line></g><g><line x1="334.10513482009475" y1="-6.62891207552606" x2="452.1476764317726" y2="-39.09061101873746" class="bpmn-flow-sequence" stroke-width="1.8" marker-end="url(#arrowhead)"></line></g><g><line x1="334.10513482009475" y1="6.62891207552606" x2="452.1476764317726" y2="39.09061101873746" class="bpmn-flow-sequence" stroke-width="1.8" marker-end="url(#arrowhead)"></line></g><g><line x1="567.8523235682275" y1="-39.09061101873746" x2="685.8948651799052" y2="-6.62891207552606" class="bpmn-flow-sequence" stroke-width="1.8" marker-end="url(#arrowhead)"></line></g><g><line x1="567.8523235682275" y1="39.09061101873746" x2="685.8948651799052" y2="6.62891207552606" class="bpmn-flow-sequence" stroke-width="1.8" marker-end="url(#arrowhead)"></line></g><g><line x1="735" y1="0" x2="890" y2="0" class="bpmn-flow-sequence" stroke-width="1.8" marker-end="url(#arrowhead)"></line></g><g role="group" aria-label="Start event: Trigger"><g aria-hidden="true"><circle cx="110" cy="0" r="18" class="bpmn-event"></circle><circle cx="110" cy="0" r="10" class="bpmn-event-start-inner"></circle><text x="110" y="30" text-anchor="middle" font-size="11" class="bpmn-text">Trigger</text></g></g><g role="group" aria-label="Parallel gateway: Split"><g aria-hidden="true"><polygon points="310,-24 334,0 310,24 286,0" class="bpmn-gateway"></polygon><line x1="310"