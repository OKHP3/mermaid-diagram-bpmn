x2="720" y2="0" class="bpmn-gateway-marker" stroke-linecap="round"></line><text x="710" y="38" text-anchor="middle" font-size="11" class="bpmn-text">Join</text></g></g><g role="group" aria-label="End event: Complete"><g aria-hidden="true"><circle cx="910" cy="0" r="18" class="bpmn-event-end"></circle><circle cx="910" cy="0" r="11" class="bpmn-event-end"></circle><text x="910" y="30" text-anchor="middle" font-size="11" class="bpmn-text">Complete</text></g></g></svg>"
`;

exports[`BpmnRenderer snapshots > 08-purchase-order-approval: SVG matches snapshot (pool/lane) 1`] = `
