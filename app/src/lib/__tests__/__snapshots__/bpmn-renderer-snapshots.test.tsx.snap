    .bpmn-lane { fill: none; stroke: hsl(var(--border)); stroke-width: 1; }
    .bpmn-lane-header { fill: hsl(var(--muted)); stroke: hsl(var(--border)); stroke-width: 1; opacity: 0.4; }
