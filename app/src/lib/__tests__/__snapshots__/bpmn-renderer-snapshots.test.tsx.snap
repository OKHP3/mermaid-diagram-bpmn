exports[`BpmnRenderer snapshots > collapsed subprocess: SVG matches snapshot 1`] = `
"<svg class="w-full h-full" viewBox="0 -360 760 720" preserveAspectRatio="xMidYMid meet" role="group" aria-labelledby="bpmn-title bpmn-desc"><title id="bpmn-title">BPMN Diagram</title><desc id="bpmn-desc">A bpmn-beta diagram</desc><defs><style>
    .bpmn-event { fill: hsl(var(--card)); stroke: hsl(var(--border)); stroke-width: 2; }
