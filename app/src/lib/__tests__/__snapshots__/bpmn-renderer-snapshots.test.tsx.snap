exports[`BpmnRenderer snapshots > 01-linear-process: SVG matches snapshot 1`] = `
"<svg class="w-full h-full" viewBox="0 -360 760 720" preserveAspectRatio="xMidYMid meet" role="group" aria-labelledby="bpmn-title bpmn-desc"><title id="bpmn-title">Simple Linear Process</title><desc id="bpmn-desc">A single user task between a start event and an end event.</desc><defs><style>
    .bpmn-event { fill: hsl(var(--card)); stroke: hsl(var(--border)); stroke-width: 2; }
    .bpmn-event-end { fill: hsl(var(--primary)); stroke: hsl(var(--primary)); stroke-width: 3; }
    .bpmn-event-start-inner { fill: hsl(var(--primary)); opacity: 0.25; }
    .bpmn-task { fill: hsl(var(--card)); stroke: hsl(var(--border)); stroke-width: 1.5; }
    .bpmn-task-hover { fill: hsl(var(--primary)); fill-opacity: 0.12; stroke: hsl(var(--primary)); stroke-width: 2; pointer-events: none; }
    .bpmn-task-ext { fill: none; stroke: hsl(var(--border)); stroke-width: 2; stroke-dasharray: 5 3; pointer-events: none; }
    .bpmn-task-marker { stroke: hsl(var(--foreground)); fill: none; stroke-width: 1.5; }
    .bpmn-subprocess-marker { stroke: hsl(var(--foreground)); stroke-width: 1.5; stroke-linecap: round; }
    .bpmn-task-text { fill: hsl(var(--foreground)); }
    .bpmn-gateway { fill: hsl(var(--card)); stroke: hsl(var(--foreground)); stroke-width: 1.8; }
    .bpmn-gateway-marker { stroke: hsl(var(--foreground)); fill: none; stroke-width: 2; stroke-linecap: round; }
    .bpmn-gateway-or-marker { stroke: hsl(var(--foreground)); fill: none; stroke-width: 1.5; }
    .bpmn-pool { fill: none; stroke: hsl(var(--border)); stroke-width: 1.5; }
    .bpmn-pool-header { fill: hsl(var(--muted)); stroke: hsl(var(--border)); stroke-width: 1.5; opacity: 0.7; }
    .bpmn-lane { fill: none; stroke: hsl(var(--border)); stroke-width: 1; }
    .bpmn-lane-header { fill: hsl(var(--muted)); stroke: hsl(var(--border)); stroke-width: 1; opacity: 0.4; }
    .bpmn-flow-sequence { stroke: hsl(var(--foreground)); opacity: 0.85; }
    .bpmn-flow-conditional { stroke: hsl(var(--foreground)); opacity: 0.85; }
    .bpmn-flow-default { stroke: hsl(var(--foreground)); opacity: 0.85; }
    .bpmn-flow-message { stroke: hsl(var(--foreground)); opacity: 0.85; stroke-dasharray: 6 4; }
    .bpmn-flow-association { stroke: hsl(var(--border)); opacity: 0.7; stroke-dasharray: 2 3; }
    .bpmn-flow--association { stroke: hsl(var(--border)); opacity: 0.7; stroke-dasharray: 2 3; }
    .bpmn-arrow { fill: hsl(var(--foreground)); }
    .bpmn-arrow-open { fill: none; stroke: hsl(var(--foreground)); stroke-width: 1; }
    .bpmn-slash { stroke: hsl(var(--foreground)); stroke-width: 1.5; }
    .bpmn-text { fill: hsl(var(--foreground)); font-family: var(--app-font-sans, 'DM Sans', system-ui, sans-serif); }
    .bpmn-text-muted { fill: hsl(var(--foreground)); opacity: 0.7; font-family: var(--app-font-mono, 'JetBrains Mono', monospace); }
    .bpmn-text-label { fill: hsl(var(--foreground)); font-family: var(--app-font-sans, 'DM Sans', system-ui, sans-serif); font-weight: 600; }
  </style><marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" class="bpmn-arrow"></polygon></marker><marker id="arrowhead-msg" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" class="bpmn-arrow-open" stroke-width="1"></polygon></marker><marker id="slash-marker" markerWidth="8" markerHeight="10" refX="4" refY="5" orient="auto"><line x1="6" y1="1" x2="2" y2="9" class="bpmn-slash"></line></marker></defs><g><line x1="130" y1="0" x2="250" y2="0" class="bpmn-flow-sequence" stroke-width="1.8" marker-end="url(#arrowhead)"></line></g><g><line x1="370" y1="0" x2="490" y2="0" class="bpmn-flow-sequence" stroke-width="1.8" marker-end="url(#arrowhead)"></line></g><g role="group" aria-label="Start event: Start"><g aria-hidden="true"><circle cx="110" cy="0" r="18" class="bpmn-event"></circle><circle cx="110" cy="0" r="10" class="bpmn-event-start-inner"></circle><text x="110" y="30" text-anchor="middle" font-size="11" class="bpmn-text">Start</text></g></g><g role="group" aria-label="User task: Submit Request"><g aria-hidden="true"><rect x="250" y="-30" width="120" height="60" rx="6" class="bpmn-task"></rect><g transform="translate(264, -18)"><circle cx="0" cy="-4" r="4" class="bpmn-task-marker"></circle><path d="M-6 8 C-6 2 6 2 6 8" class="bpmn-task-marker" stroke-linecap="round" fill="none"></path></g><text x="310" y="0" text-anchor="middle" dominant-baseline="middle" font-size="11" class="bpmn-text">Submit Request</text></g></g><g role="group" aria-label="End event: Done"><g aria-hidden="true"><circle cx="510" cy="0" r="18" class="bpmn-event-end"></circle><circle cx="510" cy="0" r="11" class="bpmn-event-end"></circle><text x="510" y="30" text-anchor="middle" font-size="11" class="bpmn-text">Done</text></g></g></svg>"
`;

