0" height="60" rx="6" class="bpmn-task"></rect><g transform="translate(664, -73)"><circle cx="0" cy="0" r="5" class="bpmn-task-marker"></circle><circle cx="0" cy="0" r="2" class="bpmn-task-marker"></circle><line x1="0" y1="-5" x2="0" y2="-7" class="bpmn-task-marker"></line><line x1="0" y1="5" x2="0" y2="7" class="bpmn-task-marker"></line><line x1="-5" y1="0" x2="-7" y2="0" class="bpmn-task-marker"></line><line x1="5" y1="0" x2="7" y2="0" class="bpmn-task-marker"></line></g><text x="710" y="-55" text-anchor="middle" dominant-baseline="middle" font-size="11" class="bpmn-text">Check Inventory</text></g></g><g role="group" aria-label="Exclusive gateway: In Stock?"><g aria-hidden="true"><polygon points="910,-24 934,0 910,24 886,0" class="bpmn-gateway"></polygon><line x1="902" y1="-8" x2="918" y2="8" class="bpmn-gateway-marker" stroke-linecap="round"></line><line x1="918" y1="-8" x2="902" y2="8" class="bpmn-gateway-marker" stroke-linecap="round"></line><text x="910" y="38" text-anchor="middle" font-size="11" class="bpmn-text">In Stock?</text></g></g><g role="group" aria-label="Service task: Pick and Pack"><g aria-hidden="true"><rect x="1050" y="-85" width="120" height="60" rx="6" class="bpmn-task"></rect><g transform="translate(1064, -73)"><circle cx="0" cy="0" r="5" class="bpmn-task-marker"></circle><circle cx="0" cy="0" r="2" class="bpmn-task-marker"></circle><line x1="0" y1="-5" x2="0" y2="-7" class="bpmn-task-marker"></line><line x1="0" y1="5" x2="0" y2="7" class="bpmn-task-marker"></line><line x1="-5" y1="0" x2="-7" y2="0" class="bpmn-task-marker"></line><line x1="5" y1="0" x2="7" y2="0" class="bpmn-task-marker"></line></g><text x="1110" y="-55" text-anchor="middle" dominant-baseline="middle" font-size="11" class="bpmn-text">Pick and Pack</text></g></g><g role="group" aria-label="User task: Notify Customer"><g aria-hidden="true"><rect x="1050" y="25" width="120" height="60" rx="6" class="bpmn-task"></rect><g transform="translate(1064, 37)"><circle cx="0" cy="-4" r="4