exports[`BpmnRenderer snapshots > 05-parallel-split: SVG matches snapshot (parallel flows) 1`] = `
"<svg class="w-full h-full" viewBox="0 -360 1160 720" preserveAspectRatio="xMidYMid meet" role="group" aria-labelledby="bpmn-title bpmn-desc"><title id="bpmn-title">Parallel Task Processing</title><desc id="bpmn-desc">Work is split in parallel across two service tasks and then joined before completion.</desc><defs><style>
    .bpmn-event { fill: hsl(var(--card)); stroke: hsl(var(--border)); stroke-width: 2; }
    .bpmn-event-end { fill: hsl(var(--primary)); stroke: hsl(var(--primary)); stroke-width: 3; }
    .bpmn-event-start-inner { fill: hsl(var(--primary)); opacity: 0.25; }
    .bpmn-task { fill: hsl(var(--card)); stroke: hsl(var(--border)); stroke-width: 1.5; }
    .bpmn-task-hover { fill: hsl(var(--primary)); fill-opacity: 0.12; stroke: hsl(var(--primary)); stroke-width: 2; pointer-events: none; }
    .bpmn-task-ext { fill: none; stroke: hsl(var(--border)); stroke-width: 2; stroke-dasharray: 5 3; pointer-events: none; }
    .bpmn-task-marker { stroke: hsl(var(--foreground)); fill: none; stroke-width: 1.5; }
    .bpmn-subprocess-marker { stroke: hsl(var(--foreground)); stroke-width: 1.5; stroke-linecap: round; }
    .bpmn-task-text { fill: hsl(var(--foreground)); }
    .bpmn-gateway { fill: hsl(var(--card)); stroke: hsl(var(--foreground)); stroke-width: 1.8; }
    .bpmn-gateway-marker { stroke: hsl(var(--foreground)); fill: none; stroke-width: 2; stroke-linecap: round; }
    .bpmn-gateway-or-marker { stroke: hsl(var(--foreground)); fill: none; stroke-width: 1.5; }
    .bpmn-pool { fill: none; stroke: hsl(var(--border)); stroke-width: 1.5; }
    .bpmn-pool-header { fill: hsl(var(--muted)); stroke: hsl(var(--border)); stroke-width: 1.5; opacity: 0.7; }
    .bpmn-lane { fill: none; stroke: hsl(var(--border)); stroke-width: 1; }
    .bpmn-lane-header { fill: hsl(var(--muted)); stroke: hsl(var(--border)); stroke-width: 1; opacity: 0.4; }
    .bpmn-flow-sequence { stroke: hsl(var(--foreground)); opacity: 0.85; }
    .bpmn-flow-conditional { stroke: hsl(var(--foreground)); opacity: 0.85; }
    .bpmn-flow-default { stroke: hsl(var(--foreground)); opacity: 0.85; }
    .bpmn-flow-message { stroke: hsl(var(--foreground)); opacity: 0.85; stroke-dasharray: 6 4; }
