{
  "schema_version": "1.0",
  "canonical_package": "<repository-relative-path>",
  "canonical_commit_or_hash": "<commit-or-package-sha256>",
  "authorized_by": "<user-or-change-request>",
  "mirrors": [
    {
      "repository": "<repository-identity-and-remote>",
      "package": "<repository-relative-path>",
      "pre_sync_git_status": "<captured-status>",
      "approval": "<authorization>",
      "recovery_path": "<branch-or-backup-reference>",
      "core_files_must_match": [
        "SKILL.md",
        "references/brand-standard.md",
        "references/eval-patterns.md",
        "references/grading-schema.md",
        "references/equilibrium-review-protocol.md",
        "assets/skill-template.md",
        "assets/equilibrium-review-record.json",
        "assets/sync-manifest-template.json",
        "evals/evals.json",
        "benchmarks/benchmark.json",
        "benchmarks/evolution-review-YYYY-MM-DD.md",
        "benchmarks/learning-ledger-YYYY-MM-DD.json",
        "benchmarks/sync-verification-YYYY-MM-DD.json",
        "scripts/validate-skill-suite.cjs"
      ],
      "approved_adapter_differences": [
        "agents/openai.yaml"
      ],
      "excluded_local_evidence": [
        "workspace/**"
      ],
      "verification": {
        "verification_kind": "current-state-reconciliation|recorded-sync-event",
        "verification_date": "<YYYY-MM-DD>",
        "core_file_hashes": "<recorded-after-sync>",
        "adapter_semantic_review": "<recorded-after-sync>",
        "validator_command": "<command-and-result>",
        "historical_limit": "<do not claim unrecorded approval, pre-sync status, or recovery information>"
      }
    }
  ]
}
